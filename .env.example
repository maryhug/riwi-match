# Copia este archivo a .env y completa con tus valores reales.
# .env no se trackea en git (ver .gitignore).

# URL base del backend FastAPI (cv-match-api). Solo se lee server-side
# (dentro de createServerFn / *.server.ts) — nunca llega al browser.
API_BASE_URL=http://localhost:8000

# Feature flag público. Habilita el consentimiento por WhatsApp y la llamada de profiling.
# Cambia a true y vuelve a desplegar cuando Meta esté listo.
VITE_ENABLE_PROFILING_OUTREACH=false

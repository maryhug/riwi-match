# Base URL del backend de RIWI MATCH (FastAPI). En este entorno el backend real corre en :8001
# porque el :8000 está ocupado por otro servicio ajeno al proyecto.
NEXT_PUBLIC_API_URL=http://localhost:8000

# true  = usa los datos mockeados de lib/data.ts (comportamiento original generado por v0, sin red)
# false = llamadas reales contra NEXT_PUBLIC_API_URL, conectado a la base de datos real
NEXT_PUBLIC_USE_MOCK=true
